{
  "$schema": "https://raw.githubusercontent.com/tauri-apps/tauri/dev/crates/tauri-cli/schema.json",
  "productName": "QvReader",
  "version": "0.1.9",
  "identifier": "com.qvreader.desktop",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "QvReader v0.1.9",
        "width": 960,
        "height": 720,
        "minWidth": 480,
        "minHeight": 320,
        "center": true,
        "resizable": true,
        "fullscreen": false,
        "focus": true,
        "transparent": false,
        "dragDropEnabled": true,
        "devtools": false,
        "visible": false
      }
    ],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "macOS": {
      "dmg": {
        "background": "assets/dmg-background.png",
        "windowSize": {
          "width": 660,
          "height": 420
        },
        "appPosition": {
          "x": 180,
          "y": 170
        },
        "applicationFolderPosition": {
          "x": 480,
          "y": 170
        }
      }
    },
    "windows": {
      "nsis": {
        "compression": "lzma"
      }
    },
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ],
    "fileAssociations": [
      {
        "ext": ["md", "markdown", "mdown", "mkd", "mkdn", "mdx", "txt"],
        "name": "Markdown Document",
        "description": "Markdown formatted document",
        "role": "Editor",
        "contentTypes": [
          "net.daringfireball.markdown",
          "text/markdown",
          "public.plain-text",
          "public.text"
        ]
      }
    ]
  }
}
