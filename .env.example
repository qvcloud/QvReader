# QvReader Client Environment Configuration Example
# Copy to .env or .env.local for local overrides (never commit secrets)

# Build Edition: 'community' or 'pro' (default: community for open-source source builds)
VITE_EDITION=community

# Official Maintainer Release Flag (default: false; true only in maintainer release CI)
# VITE_OFFICIAL_BUILD=true

# Licensing Activation API Base URL (optional override)
# VITE_ACTIVATION_API_BASE=https://api.qvreader.com/api/licenses
